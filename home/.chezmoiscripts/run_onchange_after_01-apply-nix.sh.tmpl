{{- if (or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux")) -}}
{{- $nix_profile := "linux" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- $nix_profile = "hades" -}}
{{- end -}}
{{- $nix_username := "gingama4" -}}
{{- with (index . "nix") -}}
{{- if .profile -}}{{- $nix_profile = .profile -}}{{- end -}}
{{- if .username -}}{{- $nix_username = .username -}}{{- end -}}
{{- end -}}
#!/usr/bin/env bash

: <<'DOTFILES_NIX_FINGERPRINT'
nix.profile={{ $nix_profile }}
nix.username={{ $nix_username }}
{{ include "../flake.nix" }}
{{ include "../nix/darwin/default.nix" }}
{{ include "../nix/home/common.nix" }}
{{ include "../nix/home/darwin.nix" }}
{{ include "../nix/home/linux.nix" }}
{{ include "../home/dot_config/dotfiles-nix/flake.nix.tmpl" }}
DOTFILES_NIX_FINGERPRINT

set -Eeuo pipefail

if [ "${DOTFILES_DEBUG:-}" ] ; then
  set -x
fi

readonly LOCAL_FLAKE_DIR="${HOME}/.config/dotfiles-nix"
readonly NIX_PROFILE="{{ $nix_profile }}"
readonly NIX_CMD="/nix/var/nix/profiles/default/bin/nix"
readonly DARWIN_REBUILD="/run/current-system/sw/bin/darwin-rebuild"
readonly HOME_MANAGER="${HOME}/.nix-profile/bin/home-manager"
readonly NIX_FLAKE_FLAGS=(--extra-experimental-features "nix-command flakes")

function as_root() {
  if [ "${EUID}" -eq 0 ]; then
    "$@"
    return
  fi

  sudo "$@"
}

function activate_nix() {
  if [ -e /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
    # shellcheck disable=SC1091
    . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
  elif [ -e "${HOME}/.nix-profile/etc/profile.d/nix.sh" ]; then
    # shellcheck disable=SC1091
    . "${HOME}/.nix-profile/etc/profile.d/nix.sh"
  fi
}

function nix_command() {
  if command -v nix > /dev/null 2>&1; then
    command -v nix
    return
  fi

  if [ -x "${NIX_CMD}" ]; then
    printf '%s\n' "${NIX_CMD}"
    return
  fi

  echo "nix command not found. Re-run chezmoi apply after installing Nix." >&2
  exit 1
}

function require_darwin_admin() {
  if [ "${EUID}" -eq 0 ]; then
    return
  fi

  if ! command -v sudo > /dev/null 2>&1; then
    echo "sudo command not found. Run darwin activation as root." >&2
    exit 1
  fi

  echo "nix-darwin activation requires administrator privileges."
  sudo -v
}

function apply_darwin() {
  local nix_bin
  nix_bin="$(nix_command)"

  require_darwin_admin

  if [ -x "${DARWIN_REBUILD}" ]; then
    as_root env NIX_CONFIG="experimental-features = nix-command flakes" \
      "${DARWIN_REBUILD}" switch --flake "${LOCAL_FLAKE_DIR}#${NIX_PROFILE}"
    return
  fi

  "${nix_bin}" "${NIX_FLAKE_FLAGS[@]}" build "${LOCAL_FLAKE_DIR}#darwinConfigurations.${NIX_PROFILE}.system" \
    --out-link /tmp/dotfiles-darwin-system
  as_root env NIX_CONFIG="experimental-features = nix-command flakes" \
    /tmp/dotfiles-darwin-system/sw/bin/darwin-rebuild switch --flake "${LOCAL_FLAKE_DIR}#${NIX_PROFILE}"
}

function apply_linux() {
  local nix_bin
  nix_bin="$(nix_command)"

  if [ -x "${HOME_MANAGER}" ]; then
    NIX_CONFIG="experimental-features = nix-command flakes" \
      "${HOME_MANAGER}" switch --flake "${LOCAL_FLAKE_DIR}#${NIX_PROFILE}"
    return
  fi

  "${nix_bin}" "${NIX_FLAKE_FLAGS[@]}" build "${LOCAL_FLAKE_DIR}#homeConfigurations.${NIX_PROFILE}.activationPackage" \
    --out-link /tmp/dotfiles-home-manager
  /tmp/dotfiles-home-manager/activate
}

function main() {
  activate_nix

  case "{{ .chezmoi.os }}" in
    darwin)
      apply_darwin
      ;;
    linux)
      apply_linux
      ;;
    *)
      ;;
  esac
}

main
{{- end -}}
