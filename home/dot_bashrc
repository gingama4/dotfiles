# shellcheck shell=bash
# Make the Nix/Home Manager/mise environment available even when a tool
# explicitly sources ~/.bashrc from a non-interactive shell.
# shellcheck disable=SC1091
. "${HOME}/.config/shell/agent-env.sh"

# Switch interactive bash sessions to the zsh installed by Nix/Home Manager.
case "$-" in
  *i*) ;;
  *) return ;;
esac

if [ -n "${ZSH_VERSION:-}" ] || \
  [ -n "${DOTFILES_KEEP_BASH:-}" ] || \
  [ -n "${BASH_EXECUTION_STRING:-}" ]
then
  return
fi

for zsh_path in \
  "${HOME}/.nix-profile/bin/zsh" \
  "/etc/profiles/per-user/${USER:-}/bin/zsh"
do
  if [ -x "${zsh_path}" ]; then
    exec "${zsh_path}" -l
  fi
done
