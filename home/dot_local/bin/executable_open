#!/usr/bin/env bash

set -Eeuo pipefail

function usage() {
  cat <<'EOF'
Usage:
  open [TARGET]
  open -a APPLICATION TARGET

Open a URL, file, or directory with a Windows application from WSL.

Applications:
  explorer       Windows Explorer (also used by default)
  chrome         Google Chrome

With no TARGET, the current directory is opened in Explorer.
EOF
}

function die() {
  echo "open: $*" >&2
  exit 2
}

function require_command() {
  if ! command -v "$1" > /dev/null 2>&1; then
    die "required WSL command not found: $1"
  fi
}

function is_uri() {
  [[ "$1" =~ ^[[:alpha:]][[:alnum:]+.-]*: ]]
}

function windows_target() {
  local target="$1"

  if is_uri "${target}"; then
    printf '%s\n' "${target}"
    return
  fi

  if [[ ! -e "${target}" ]]; then
    die "target does not exist: ${target}"
  fi

  require_command wslpath
  wslpath -aw -- "${target}"
}

function open_with_explorer() {
  local target="$1"

  require_command explorer.exe
  explorer.exe "${target}"
}

function open_with_chrome() {
  local target="$1"
  local encoded_target

  require_command base64
  require_command powershell.exe
  encoded_target="$(printf '%s' "${target}" | base64 | tr -d '\n')"

  # PowerShell expands these variables; Bash must pass the program literally.
  # shellcheck disable=SC2016
  powershell.exe -NoLogo -NoProfile -NonInteractive -Command \
    '$target = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($args[0])); $argument = [char]34 + $target.Replace([char]34, ([char]92 + [char]34)) + [char]34; try { Start-Process -FilePath "chrome.exe" -ArgumentList $argument -ErrorAction Stop } catch { Write-Error "Google Chrome could not be started. Ensure Windows Chrome is installed."; exit 127 }' \
    "${encoded_target}"
}

function main() {
  local application="explorer"
  local target="."

  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi

  if [[ "${1:-}" == "-a" ]]; then
    [[ $# -ge 2 ]] || die "-a requires an application name"
    application="$2"
    shift 2
  elif [[ "${1:-}" == --* || "${1:-}" == -* ]]; then
    die "unknown option: $1"
  fi

  if [[ "${1:-}" == "--" ]]; then
    shift
  fi

  if [[ $# -gt 1 ]]; then
    die "only one target can be opened at a time"
  fi
  if [[ $# -eq 1 ]]; then
    target="$1"
  fi

  target="$(windows_target "${target}")"

  case "${application}" in
    explorer|Explorer)
      open_with_explorer "${target}"
      ;;
    chrome|Chrome|"Google Chrome"|"google chrome")
      open_with_chrome "${target}"
      ;;
    *)
      die "unsupported application: ${application}"
      ;;
  esac
}

main "$@"
